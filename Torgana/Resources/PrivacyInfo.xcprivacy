<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Отслеживания (рекламных идентификаторов, слежки между приложениями) нет. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!-- Что собирает сама оболочка: адрес устройства для push — только чтобы присылать уведомления этому пользователю.
	     Остальное (объявления, чаты, профиль) собирает сайт; это указывается в анкете «App Privacy» в App Store Connect. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeDeviceID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>
	</array>
	<!-- Системные API, для которых Apple требует указать причину: в коде приложения не используются. -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array/>
</dict>
</plist>
